# FAR Skill Configuration
# Copy this file to .env and fill in your API keys to enable AI features.

# OpenAI API Key (Required for Audio/Video transcription and Image Vision)
# If not provided, the skill will fall back to local tools (ffprobe, tesseract).
OPENAI_API_KEY=sk-...

# Optional: Custom OpenAI Base URL (e.g. for proxies or compatible endpoints)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Use Apple Vision (macOS on-device OCR + labels + face/barcode/body/feature-print)
# Default on macOS: enabled
# FAR_USE_APPLE_VISION=1

# Optional: Include Spotlight metadata (mdls) in every .meta on macOS
# FAR_USE_MACOS_METADATA=1

# Optional: Apple Vision tuning
# FAR_APPLE_VISION_TIMEOUT=25
# FAR_APPLE_VISION_MAX_FRAMES=6
